@baseUrl = http://localhost:8080
@userId = 11111111-1111-4111-8111-111111111111
@noteId = 1
@tag = work

###
# @name healthCheck
GET {{baseUrl}}/alive

###
# @name createNote
POST {{baseUrl}}/notes/
X-User-ID: {{userId}}
Content-Type: application/json

{
  "title": "title",
  "body": "body",
  "tags": ["work", "plans"]
}

###
# @name listNotes
GET {{baseUrl}}/notes/?limit=20&offset=0
X-User-ID: {{userId}}

###
# @name listNotesByTag
GET {{baseUrl}}/notes/?limit=20&offset=0&tag={{tag}}
X-User-ID: {{userId}}

### 
# @name getNote
GET {{baseUrl}}/notes/{{noteId}}
X-User-ID: {{userId}}

###
# @name updateNote
PUT {{baseUrl}}/notes/{{noteId}}
X-User-ID: {{userId}}
Content-Type: application/json

{
  "title": "title2",
  "body": "body2",
  "tags": ["work"]
}

###
# @name countNotes
GET {{baseUrl}}/notes/count
X-User-ID: {{userId}}

###
# @name deleteNote
DELETE {{baseUrl}}/notes/{{noteId}}
X-User-ID: {{userId}}
